    <!-- Definitions of GROUPs and FIELDs -->
    <FIELD name="recno" ucd="meta.record" datatype="int" width="8"><!-- ucd="RECORD" -->
      <DESCRIPTION>Record number assigned by the VizieR team. Should Not be used for identification.</DESCRIPTION>
      <LINK href="http://vizier.u-strasbg.fr/viz-bin/VizieR-5?-info=XML&amp;-out.add=.&amp;-source=VII/238/newobs&amp;recno=${recno}"/>
    </FIELD>
    <FIELD name="PGC" ucd="meta.id;meta.main" datatype="int" width="7"><!-- ucd="ID_MAIN" -->
      <DESCRIPTION>PGC number from LEDA</DESCRIPTION>
      <LINK href="http://vizier.u-strasbg.fr/viz-bin/VizieR-5?-info=XML&amp;-out.add=.&amp;-source=VII/238/newobs&amp;recno=${recno}"/>
    </FIELD>
    <FIELD name="AName" ucd="meta.id" datatype="char" arraysize="15*"><!-- ucd="ID_ALTERNATIVE" -->
      <DESCRIPTION>Alternate name from LEDA</DESCRIPTION>
    </FIELD>
    <FIELD name="RAJ2000" ucd="pos.eq.ra;meta.main" ref="J2000" datatype="char" arraysize="11" xtype="hms"><!-- ucd="POS_EQ_RA_MAIN" -->
      <DESCRIPTION>Right ascension (J2000)</DESCRIPTION>
    </FIELD>
    <FIELD name="DEJ2000" ucd="pos.eq.dec;meta.main" ref="J2000" datatype="char" arraysize="9" xtype="dms"><!-- ucd="POS_EQ_DEC_MAIN" -->
      <DESCRIPTION>Declination (J2000)</DESCRIPTION>
    </FIELD>
    <FIELD name="VHI" ucd="spect.dopplerVeloc" datatype="float" width="6" unit="km/s"><!-- ucd="SPECT_VELOC_VALUE" -->
      <DESCRIPTION>HI heliocentric radial velocitY</DESCRIPTION>
    </FIELD>
    <FIELD name="e_VHI" ucd="stat.error" datatype="float" width="4" unit="km/s"><!-- ucd="ERROR" -->
      <DESCRIPTION>? rms uncertainty on VHI</DESCRIPTION>
      <VALUES null="NaN" />
    </FIELD>
    <FIELD name="W20" ucd="spect.line.width;em.radio.750-1500MHz" datatype="float" width="4" unit="km/s"><!-- ucd="SPECT_LINE_WIDTH" -->
      <DESCRIPTION>21-cm line width at 20% of the maximum</DESCRIPTION>
    </FIELD>
    <FIELD name="e_W20" ucd="stat.error" datatype="float" width="4" unit="km/s"><!-- ucd="ERROR" -->
      <DESCRIPTION>? rms uncertainty on W20</DESCRIPTION>
      <VALUES null="NaN" />
    </FIELD>
    <FIELD name="W50" ucd="spect.line.width;em.radio.750-1500MHz" datatype="float" width="4" unit="km/s"><!-- ucd="SPECT_LINE_WIDTH" -->
      <DESCRIPTION>21-cm line width at 50% of the mqximuM</DESCRIPTION>
    </FIELD>
    <FIELD name="e_W50" ucd="stat.error" datatype="float" width="4" unit="km/s"><!-- ucd="ERROR" -->
      <DESCRIPTION>? rms uncertainty on W50</DESCRIPTION>
      <VALUES null="NaN" />
    </FIELD>
    <FIELD name="FHI" ucd="phot.flux.density;em.line.HI;spect.line" datatype="float" width="5" precision="2" unit="mJy.km/s"><!-- ucd="SPECT_FLUX_VALUE" -->
