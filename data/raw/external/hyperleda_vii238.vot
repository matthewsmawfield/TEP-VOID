    </FIELD>
    <FIELD name="S/N" ucd="stat.snr" datatype="float" width="4" precision="1"><!-- ucd="INST_S/N" -->
      <DESCRIPTION>Signal to Noise ratio</DESCRIPTION>
    </FIELD>
    <FIELD name="Qual" ucd="meta.code.qual;spect.line" datatype="char" arraysize="1"><!-- ucd="CODE_QUALITY" -->
