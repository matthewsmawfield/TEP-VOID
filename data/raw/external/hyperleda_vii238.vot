    </FIELD>
    <FIELD name="n_FHI" ucd="meta.note" datatype="char" arraysize="1"><!-- ucd="NOTE" -->
      <DESCRIPTION>[*] indicates a Flux uncorrected for the beam-filling effect</DESCRIPTION>
    </FIELD>
    <FIELD name="e_FHI" ucd="stat.error" datatype="float" width="5" precision="2" unit="mJy.km/s"><!-- ucd="ERROR" -->
