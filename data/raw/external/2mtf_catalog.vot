  <TABLE ID="J_MNRAS_487_2061_table2" name="J/MNRAS/487/2061/table2">
    <DESCRIPTION>Distances and peculiar velocities for 2062 2MTF galaxies</DESCRIPTION>
    <!-- Definitions of GROUPs and FIELDs -->

<!-- +++No column could be found to attach a LINK in table: J/MNRAS/487/2061/table2 -->
    <FIELD name="recno" ucd="meta.record" datatype="int" width="8"><!-- ucd="RECORD" -->
      <DESCRIPTION>Record number assigned by the VizieR team. Should Not be used for identification.</DESCRIPTION>
      <LINK href="http://vizier.u-strasbg.fr/viz-bin/VizieR-5?-info=XML&amp;-out.add=.&amp;-source=J/MNRAS/487/2061/table2&amp;recno=${recno}"/>
    </FIELD>
    <FIELD name="2MASX" ucd="meta.id;meta.main" datatype="char" arraysize="16"><!-- ucd="ID_MAIN" -->
      <DESCRIPTION>2MASS XSC ID name (HHMMSSss+DDMMSSs)</DESCRIPTION>
      <LINK href="http://vizier.u-strasbg.fr/viz-bin/VizieR-4?-info=XML&amp;-out.add=.&amp;-source=J/MNRAS/487/2061&amp;2MASX=${2MASX}"/>
    </FIELD>
    <FIELD name="czCMB" ucd="pos.frame;pos.cmb" datatype="int" width="5" unit="km/s"><!-- ucd="VELOC_CMB" -->
      <DESCRIPTION>CMB frame redshift</DESCRIPTION>
    </FIELD>
    <FIELD name="logdK" ucd="pos.distance" datatype="float" width="7" precision="4"><!-- ucd="PHYS_DISTANCE_TRUE" -->
      <DESCRIPTION>Logarithmic distance quantity measured by K band magnitude</DESCRIPTION>
    </FIELD>
    <FIELD name="e_logdK" ucd="stat.error" datatype="float" width="7" precision="4"><!-- ucd="ERROR" -->
      <DESCRIPTION>Error of logarithmic distance quantity measured by K band magnitude</DESCRIPTION>
    </FIELD>
    <FIELD name="logdH" ucd="pos.distance" datatype="float" width="7" precision="4"><!-- ucd="PHYS_DISTANCE_TRUE" -->
      <DESCRIPTION>Logarithmic distance quantity measured by H band magnitude</DESCRIPTION>
    </FIELD>
    <FIELD name="e_logdH" ucd="stat.error" datatype="float" width="7" precision="4"><!-- ucd="ERROR" -->
      <DESCRIPTION>Error of logarithmic distance quantity measured by H band magnitude</DESCRIPTION>
    </FIELD>
    <FIELD name="logdJ" ucd="pos.distance" datatype="float" width="7" precision="4"><!-- ucd="PHYS_DISTANCE_TRUE" -->
      <DESCRIPTION>Logarithmic distance quantity measured by J band magnitude</DESCRIPTION>
    </FIELD>
    <FIELD name="e_logdJ" ucd="stat.error" datatype="float" width="7" precision="4"><!-- ucd="ERROR" -->
      <DESCRIPTION>Error of logarithmic distance quantity measured by J band magnitude</DESCRIPTION>
    </FIELD>
    <FIELD name="VpecK" ucd="phys.veloc" datatype="double" width="9" precision="2" unit="km/s"><!-- ucd="VELOC_PECULIAR" -->
      <DESCRIPTION>Peculiar velocity measured by K band magnitude</DESCRIPTION>
    </FIELD>
    <FIELD name="e_VpecK" ucd="stat.error" datatype="float" width="7" precision="2" unit="km/s"><!-- ucd="ERROR" -->
      <DESCRIPTION>Error of peculiar velocity measured by K band magnitude</DESCRIPTION>
    </FIELD>
    <FIELD name="VpecH" ucd="phys.veloc" datatype="double" width="9" precision="2" unit="km/s"><!-- ucd="VELOC_PECULIAR" -->
      <DESCRIPTION>Peculiar velocity measured by H band magnitude</DESCRIPTION>
    </FIELD>
    <FIELD name="e_VpecH" ucd="stat.error" datatype="float" width="7" precision="2" unit="km/s"><!-- ucd="ERROR" -->
      <DESCRIPTION>Error of peculiar velocity measured by H band magnitude</DESCRIPTION>
    </FIELD>
    <FIELD name="VpecJ" ucd="phys.veloc" datatype="double" width="9" precision="2" unit="km/s"><!-- ucd="VELOC_PECULIAR" -->
      <DESCRIPTION>Peculiar velocity measured by J band magnitude</DESCRIPTION>
    </FIELD>
    <FIELD name="e_VpecJ" ucd="stat.error" datatype="float" width="7" precision="2" unit="km/s"><!-- ucd="ERROR" -->
      <DESCRIPTION>Error of peculiar velocity measured by J band magnitude</DESCRIPTION>
    </FIELD>
    <FIELD name="VWFK" ucd="phys.veloc" datatype="double" width="9" precision="2" unit="km/s"><!-- ucd="VELOC_PECULIAR" -->
      <DESCRIPTION>Peculiar velocity calculated by WF15 estimator with K band magnitude</DESCRIPTION>
    </FIELD>
    <FIELD name="e_VWFK" ucd="stat.error" datatype="float" width="7" precision="2" unit="km/s"><!-- ucd="ERROR" -->
      <DESCRIPTION>Error of peculiar velocity calculated by WF15 estimator with K band magnitude</DESCRIPTION>
    </FIELD>
    <FIELD name="VWFH" ucd="phys.veloc" datatype="double" width="9" precision="2" unit="km/s"><!-- ucd="VELOC_PECULIAR" -->
      <DESCRIPTION>Peculiar velocity calculated by WF15 estimator with H band magnitude</DESCRIPTION>
    </FIELD>
    <FIELD name="e_VWFH" ucd="stat.error" datatype="float" width="7" precision="2" unit="km/s"><!-- ucd="ERROR" -->
      <DESCRIPTION>Error of peculiar velocity calculated by WF15 estimator with H band magnitude</DESCRIPTION>
    </FIELD>
    <FIELD name="VWFJ" ucd="phys.veloc" datatype="double" width="9" precision="2" unit="km/s"><!-- ucd="VELOC_PECULIAR" -->
      <DESCRIPTION>Peculiar velocity calculated by WF15 estimator with J band magnitude</DESCRIPTION>
    </FIELD>
    <FIELD name="e_VWFJ" ucd="stat.error" datatype="float" width="7" precision="2" unit="km/s"><!-- ucd="ERROR" -->
      <DESCRIPTION>Error of peculiar velocity calculated by WF15 estimator with J band magnitude</DESCRIPTION>
    </FIELD>
    <FIELD name="Flag" ucd="meta.code.error" datatype="char" arraysize="2"><!-- ucd="CODE_MISC" -->
      <DESCRIPTION>Data quality warning flag, a flag 'W' reminds one to use the measurement of the galaxy carefully</DESCRIPTION>
    </FIELD>
